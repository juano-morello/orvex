#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "$0")"
common=$(git rev-parse --path-format=absolute --git-common-dir)
registry="$common/orvex-previews"
mkdir -p -- "$registry"
export ORVEX_UID=$(id -u) ORVEX_GID=$(id -g)

# Git removes its link when the worktree registration goes away. The other
# link keeps the project identity and Docker engine ID available for cleanup.
exec 8<"$registry"
if [[ ${1:-} == gc ]]; then
  shopt -s nullglob
  for receipt in "$registry"/orvex-wt-*; do
    (
      flock 8
      [[ -f $receipt && ! -L $receipt ]] || exit 0
      exec 9<"$receipt"
      flock -n 9 || exit 0
      [[ $(stat -c %h "$receipt") == 1 ]] || exit 0
      exec 8<&-
      project=${receipt##*/}
      [[ $project =~ ^orvex-wt-[0-9a-f-]{36}$ ]] || exit 1
      engine=$(docker info --format '{{.ID}}')
      [[ $engine == "$(<"$receipt")" ]] || exit 0
      export ORVEX_WORKSPACE_ID=$project
      docker compose -p "$project" -f deployments/docker/compose.yaml \
        -f .devcontainer/compose.yaml down --volumes --remove-orphans
      rm -- "$receipt"
      echo "Removed preview $project"
    ) 8<"$registry"
  done
  exit 0
fi
if [[ ! -f .git ]]; then
  echo 'Run ./workspace from a linked Git worktree so shared Git metadata stays outside the container.' >&2
  exit 2
fi
git_dir=$(git rev-parse --absolute-git-dir)
flock 8
shopt -s nullglob
markers=("$git_dir"/orvex-wt-*)
if (( ${#markers[@]} == 0 )); then
  project="orvex-wt-$(cat /proc/sys/kernel/random/uuid)"
  marker="$git_dir/$project"
  engine=$(docker info --format '{{.ID}}')
  printf '%s\n' "$engine" > "$marker"
else
  marker=${markers[0]}
  project=${marker##*/}
  engine=$(docker info --format '{{.ID}}')
  [[ $engine == "$(<"$marker")" ]] || { echo 'Switch back to the Docker engine that owns this preview.' >&2; exit 1; }
fi
receipt="$registry/$project"
[[ -f $receipt ]] || ln -- "$marker" "$receipt"
exec 9<"$receipt"
flock -s 9
exec 8<&-
export ORVEX_WORKSPACE_ID=$project COMPOSE_PROJECT_NAME=$project
compose=(docker compose -p "$ORVEX_WORKSPACE_ID" -f deployments/docker/compose.yaml -f .devcontainer/compose.yaml)

# The preview's credentials live in a Docker volume of this project, beside
# its database volume, and survive recreating the dev container.
creds=/var/lib/orvex-preview
# Earlier previews kept them under the dev container's HOME, which vanishes
# with the container.
legacy=/tmp/.local/state/orvex-demo

dev_container() { "${compose[@]}" ps -aq dev; }
has_credentials_volume() {
  local mounts
  mounts=$(docker inspect -f '{{range .Mounts}}{{.Destination}} {{end}}' "$1")
  [[ " $mounts " == *" $creds "* ]]
}
credentials_exist() {
  "${compose[@]}" run --rm -T --no-deps --entrypoint test credentials -e /credentials/keyring
}
# Sealed round secrets whose rounds have not settled. Only the original
# keyring opens them (LBT-21 K-4).
unrevealed_rounds() {
  "${compose[@]}" exec -T postgres psql -XqAt -v ON_ERROR_STOP=1 -U orvex -d orvex \
    < deployments/docker/unrevealed-rounds.sql
}
# Preserve credentials before replacing a dev container with ephemeral storage.
adopt_earlier_credentials() {
  local cid=$1 count
  "${compose[@]}" up -d --wait --no-deps postgres
  "${compose[@]}" run --rm -T --no-deps credentials
  if docker cp "$cid:$legacy" - >/dev/null 2>&1; then
    docker cp "$cid:$legacy" - |
      "${compose[@]}" run --rm -T --no-deps dev python3 deployments/docker/demo-credentials.py adopt "$creds"
  fi
  if ! credentials_exist; then
    count=$(unrevealed_rounds) || return 1
    if [[ $count != 0 ]]; then
      echo 'This preview has an unsettled round, and its keyring is not in the old dev container at '"$legacy"'.' >&2
      echo 'Copy the keyring out of the container, then run ./workspace restore-keyring FILE. The dev container was left in place.' >&2
      exit 3
    fi
  fi
}
prepare_dev() {
  local cid
  cid=$(dev_container)
  if [[ -n $cid ]] && ! has_credentials_volume "$cid"; then
    adopt_earlier_credentials "$cid"
  elif [[ ${1:-} != recreate ]]; then
    return 0
  fi
  "${compose[@]}" up -d --force-recreate dev
}
require_current_dev() {
  local cid
  cid=$(dev_container)
  if [[ -n $cid ]] && ! has_credentials_volume "$cid"; then
    echo 'This preview predates persistent credentials. Run ./workspace preview to upgrade it and keep its key.' >&2
    exit 1
  fi
}

case "${1:-}" in
  shell|exec)
    mode=$1
    shift
    require_current_dev
    "${compose[@]}" up -d --no-recreate dev
    exec 9<&-
    if [[ $mode == shell ]]; then
      exec "${compose[@]}" exec dev bash
    fi
    exec "${compose[@]}" exec -T dev "$@"
    ;;
  preview)
    prepare_dev
    "${compose[@]}" up -d --wait --no-recreate dev postgres
    "${compose[@]}" exec -T dev make build-crashctl
    "${compose[@]}" exec -T dev ./bin/crashctl migrate up
    count=$(unrevealed_rounds)
    "${compose[@]}" exec -T dev python3 deployments/docker/demo-credentials.py ensure "$creds" --unrevealed "$count"
    exec "${compose[@]}" exec -T dev ./bin/crashctl migrate status
    ;;
  recreate)
    prepare_dev recreate
    ;;
  restore-keyring)
    [[ -f ${2:-} ]] || { echo 'usage: ./workspace restore-keyring FILE' >&2; exit 2; }
    "${compose[@]}" run --rm -T --no-deps credentials
    exec "${compose[@]}" run --rm -T --no-deps dev python3 deployments/docker/demo-credentials.py restore "$creds" < "$2"
    ;;
  devcontainer)
    prepare_dev
    exec devcontainer up --workspace-folder "$PWD"
    ;;
  stop) exec "${compose[@]}" stop ;;
  dispose) exec "${compose[@]}" down --volumes ;;
  *) echo 'usage: ./workspace shell | exec COMMAND... | preview | recreate | restore-keyring FILE | devcontainer | stop | dispose | gc' >&2
     exit 2 ;;
esac
